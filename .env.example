# Copy to .env.local and fill in. Server-only values: never prefix these with NEXT_PUBLIC_.

# Footer newsletter form. The Server Action POSTs {"email","source","submittedAt"} as JSON
# here; any 2xx counts as success. Unset: development logs a masked address and reports
# success; production logs an error and shows the visitor a generic failure.
NEWSLETTER_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <value>" when set.
NEWSLETTER_WEBHOOK_SECRET=

# "Book a Free Demo Class" dialog. The Server Action POSTs the lead as JSON here
# ({type,source,requestId,submittedAt,child,parent,booking,languages,consent}); any 2xx
# counts as success. Unset: development logs a masked summary and shows the confirmation;
# production logs an error and shows the parent a generic failure, never a confirmation.
LEADS_WEBHOOK_URL=
# Optional. Sent as "Authorization: Bearer <value>" when set.
LEADS_WEBHOOK_SECRET=
